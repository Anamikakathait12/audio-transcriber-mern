# Server Port
PORT=5000

# MongoDB Atlas Connection String
# Replace <username> and <password> with your Atlas database credentials
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/audio_transcriber?retryWrites=true&w=majority

# Groq API Key (get free API key from https://console.groq.com/keys)
GROQ_API_KEY=your_groq_api_key_here

# AssemblyAI API Key (get free API key from https://www.assemblyai.com)
ASSEMBLY_API_KEY=your_assemblyai_api_key_here

# JWT Authentication
# Required: Server will refuse to start if JWT_SECRET is missing
JWT_SECRET=your_jwt_secret_key_minimum_32_chars_long
JWT_EXPIRES_IN=7d
